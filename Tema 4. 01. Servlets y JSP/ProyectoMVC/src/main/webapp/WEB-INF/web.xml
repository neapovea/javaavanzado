<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">
  <servlet>
    <description></description>
    <display-name>ClienteController</display-name>
    <servlet-name>ClienteController</servlet-name>
    <servlet-class>controller.ClienteController</servlet-class>    
  </servlet>
  <servlet-mapping>
    <servlet-name>ClienteController</servlet-name>
    <url-pattern>/ClienteController</url-pattern>
  </servlet-mapping>
<servlet>
    <!-- Un nombre interno para enlazar ambas etiquetas -->
    <servlet-name>ServletPrincipal</servlet-name> 
    <!-- La ruta real de tu clase Java, incluyendo su paquete -->
    <servlet-class>web.PrimerServlet</servlet-class> 
</servlet>

<servlet-mapping>
    <!-- Debe coincidir exactamente con el nombre de arriba -->
    <servlet-name>ServletPrincipal</servlet-name>
    <!-- Esta es la URL final que escribirás en el navegador -->
    <url-pattern>/PrimerServlet</url-pattern> 
</servlet-mapping>  
  <display-name>ProyectoMVC</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
</web-app>